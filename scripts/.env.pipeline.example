# Copy to scripts/.env.pipeline and fill in.
# Vertex AI / TTS / Imagen project
export GCP_PROJECT_ID="your-gcp-project"
export GCP_REGION="asia-southeast1"          # Singapore
# Google AI Studio API key for Gemini (aistudio.google.com → Get API key)
export GEMINI_API_KEY="AIza..."
# Optional avatar animation platforms
export HEYGEN_API_KEY=""
export SYNTHESIA_API_KEY=""
# (Optional) publicly reachable place to host assets for HeyGen/Synthesia,
# e.g. an R2/S3 bucket or a raw GitHub URL.
export ASSET_BASE_URL="https://example.com/ivanbuilds-assets"
