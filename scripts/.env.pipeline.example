# Copy to scripts/.env.pipeline and fill in. (Free stack — no billing anywhere.)
# Google AI Studio API key for Gemini script generation
# (aistudio.google.com → Get API key — free tier)
export GEMINI_API_KEY="AIza..."
# Optional: model override for scripts/generate_script_gemini.sh
export GEMINI_MODEL="gemini-2.0-flash"
