# ── Contact form routing — see README → "Contact form setup" ────────────────

# BEST — own Cloudflare Pages Function (server-side secret, direct to inbox):
# set when deploying on Cloudflare Pages; relay via Resend, 3000 emails/mo free.
# VITE_CONTACT_API=/api/contact

# Alternative A — Formspree (if staying on GitHub Pages, no function):
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Alternative B — EmailJS:
# VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxx

# Fallback without any relay: the form opens a pre-filled mailto draft to:
VITE_CONTACT_EMAIL=hello@ivanbuilds.dev
