# ── Contact form: pick ONE of the two options below ──────────────────────

# Option A — Formspree (simplest): create a form at https://formspree.io,
# copy the endpoint and paste it here. Nothing else needed.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Option B — EmailJS: https://dashboard.emailjs.com
#   1. Email Services  → add your inbox (Gmail etc.) → note the Service ID
#   2. Email Templates → create a template using the variables
#      {{from_name}} {{reply_to}} {{inquiry_type}} {{message}}
#   3. Account → API Keys → copy the Public key
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxx

# Public contact address shown on the site (also used by the mailto fallback).
# NOTE: to avoid committing this, you can also set VITE_CONTACT_EMAIL as a
# GitHub Actions secret (see deploy.yml) and leave this line unset locally.
# For local runs the default in src/data/site.js is used — edit that constant.
VITE_CONTACT_EMAIL=hello@ivanbuilds.dev
