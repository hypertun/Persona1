# ── CLIENT-side config (Vite) — copy to .env — everything here is PUBLIC:
# it gets baked into the JavaScript bundle on every visitor's machine.
# Never put credentials (GMAIL_APP_PASSWORD, RESEND_API_KEY, …) in this file;
# the /api/contact credentials live SERVER-side in .dev.vars (local — copy
# from .dev.vars.example) or Cloudflare → Settings → Variables & Secrets.
#
# Routing priority (auto-detected at build time):
#   1. own Cloudflare Pages Function → uncomment VITE_CONTACT_API below
#   2. Formspree / EmailJS relay
#   3. mailto fallback (nothing configured)

# 1 — own Cloudflare Pages Function (recommended; Gmail SMTP behind it):
#    set in the Cloudflare build env for production, or uncomment locally
#    + `npm run dev:cf` to test the full loop with the function.
# VITE_CONTACT_API=/api/contact

# 2 — Formspree (if staying on GitHub Pages, no function):
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# 2 — EmailJS:
# VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxx

# 3 — mailto fallback recipient (public; defaults to src/data/site.js):
VITE_CONTACT_EMAIL=hello@ivanbuilds.dev
